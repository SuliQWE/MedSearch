# Supabase (каталог препаратов и картинки). Без этих переменных сайт работает на тестовом каталоге из кода.
# Settings -> API в панели Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Только на сервере. Никогда не публикуйте и не коммитьте реальный ключ. На Vercel задаётся в Settings -> Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Текущая версия (этапы 1-4) работает в демо-режиме без внешних сервисов.
# Переменные ниже понадобятся при подключении Supabase (см. README, раздел "База данных").

# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Только на сервере. Никогда не выносите в клиентский код.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Путь к файлу SQLite (по умолчанию ./data/medifinder.db, на Vercel /tmp/medifinder.db — данные временные)
# DATABASE_PATH=./data/medifinder.db
